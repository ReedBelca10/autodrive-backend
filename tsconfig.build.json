{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "sourceMap": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "strict": false
  },
  "exclude": ["node_modules", "test", "dist", "**/*.spec.ts", "**/*.test.ts", "**/__tests__/**"]
}
