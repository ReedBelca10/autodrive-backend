# Copy to .env and fill values. Do NOT commit real secrets.

PORT=3001
NODE_ENV=production

# MongoDB Atlas URI or local Mongo connection
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/autodrive?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES=7d

# Supabase (optional)
SUPABASE_URL=
SUPABASE_KEY=

# Payment providers (optional)
STRIPE_SECRET_KEY=
FEDAPAY_API_KEY=

# Frontend origin
FRONTEND_ORIGIN=http://localhost:3000
# Backend example environment variables
# Rename to .env and fill with real values for local development

# Server
PORT=3001
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/autodrive

# JWT / Auth
JWT_SECRET=change_me
ADMIN_SEED_KEY=your-admin-seed-key

# Frontend / Origins
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_ORIGIN=http://localhost:3001

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=

# Supabase (optional - for media storage)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=avatars
SUPABASE_BUCKET_BLOG_MEDIAS=blog-medias

# Email
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password

# Payment gateways
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_PUBLIC_KEY=

# Misc
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
