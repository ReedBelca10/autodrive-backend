# Copy to .env and fill values. Do NOT commit real secrets.

# Server
NODE_ENV=development
PORT=3001

# Database
# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/autodrive

# JWT / Auth
JWT_SECRET=change_me_secure_jwt_secret
JWT_EXPIRES=7d
ADMIN_SEED_KEY=your-admin-seed-key

# Frontend / Origins
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_ORIGIN=http://localhost:3001
BACKEND_URL=http://localhost:3001

# OAuth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Supabase (optional - media storage)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=avatars
SUPABASE_BUCKET_BLOG_MEDIAS=blog-medias

# Email (for contact/notifications)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-app-password

# Payments
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_PUBLIC_KEY=

# Misc / frontend integration (used by the frontend)
NEXT_PUBLIC_API_BASE=http://localhost:3001

# Note: keep real secrets out of source control. Use a secure secret manager for production.
